find . -type f -name "*seed*" | while read f; do
    new=$(echo "$f" | sed -E \
    's#D&M-##;
     s/B0*([0-9]+)/B\1/;
     s/R0*([0-9]+)/R\1/;
     s/H0*([0-9]+)/H\1/;
     s/L0*([0-9]+)/L\1/;
     s/F0*([0-9]+)/F\1/;
     s/-distMin1ItemFamily_seed0*/-/')
    mv "$f" "$new"
done

